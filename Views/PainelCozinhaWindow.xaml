<Window x:Class="PizzariaApp.Views.PainelCozinhaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PizzariaApp.Converters"
        Title="Painel da Cozinha" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#222222">

    <Window.Resources>
        <conv:StatusParaCorConverter x:Key="StatusParaCor"/>
        <conv:StatusParaTextoConverter x:Key="StatusParaTexto"/>
    </Window.Resources>

    <DockPanel Margin="15">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="🍕 Painel da Cozinha" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="TxtUltimaAtualizacao" Foreground="#AAAAAA" Margin="20,6,0,0" FontSize="12"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaPedidos">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="10" Margin="8" Padding="15" Width="320">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Id, StringFormat=Pedido #{0}}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HoraPedido}" Foreground="Gray"/>
                                </Grid>

                                <Border Background="{Binding Status, Converter={StaticResource StatusParaCor}}"
                                        CornerRadius="4" Padding="6,2" Margin="0,6,0,10" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusParaTexto}}"
                                               Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>

                                <TextBlock Text="{Binding NomeCliente}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Telefone}" Foreground="Gray" FontSize="12"/>
                                <TextBlock Text="{Binding Endereco}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding ItensResumo}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding ValorTotal, StringFormat=Total: {0:C}}"
                                           FontWeight="Bold" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Em Preparo" Width="130" Height="34" Margin="0,0,8,0"
                                            Command="{Binding ComandoEmPreparo}"
                                            Style="{StaticResource BotaoPadrao}"/>
                                    <Button Content="Pronto p/ Entrega" Width="150" Height="34"
                                            Command="{Binding ComandoPronto}"
                                            Style="{StaticResource BotaoPadrao}"
                                            Background="{StaticResource CorSecundaria}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
